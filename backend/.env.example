# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND RBAC
# ==========================================

# 1. Cấu hình Server HTTP
PORT=3000
NODE_ENV=development

# 2. Cấu hình Cơ sở dữ liệu PostgreSQL (Supabase / Postgres Local)
# Lưu ý: Nếu dùng Supabase Pooler hoặc Direct Connection, hãy gán URL và bật DB_SSL=true
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_SSL=true

# 3. Cấu hình JWT Access Token (bắt buộc >= 32 ký tự)
JWT_ACCESS_SECRET=c2VjdXJpdHktand0LXNlY3JldC1hdXRoLXJiYWMtZGVtby0yMDI2LWVudGVycHJpc2U=
JWT_ACCESS_EXPIRES_IN=15m

# 4. Cấu hình Redis Token Blacklist (Tự động chuyển sang In-memory nếu Redis offline)
REDIS_URL=redis://127.0.0.1:6379

# 5. Cấu hình Google Single Sign-On (SSO / OAuth 2.0)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

