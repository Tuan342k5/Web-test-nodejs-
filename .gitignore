# ==========================================
# Root .gitignore - Chống commit file bí mật
# ==========================================

# 1. Environment Variables (Bảo vệ thông tin nhạy cảm)
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
!**/.env.example

# 2. Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.js

# 3. Build & Distribution
dist/
**/dist/
dist-ssr/
build/

# 4. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. OS & Editor configs
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

